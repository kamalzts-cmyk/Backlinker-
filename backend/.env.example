# Copy to backend/.env for local (non-Docker) development. Never commit
# a real .env -- see ../.gitignore.

POSTGRES_USER=linkintel
POSTGRES_PASSWORD=linkintel
POSTGRES_DB=linkintel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# A second Postgres database named "<POSTGRES_DB>_test" is expected to
# exist for the integration test suite (app/tests/integration/conftest.py)
# so tests never touch the dev database's data.

REDIS_HOST=localhost
REDIS_PORT=6379

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Powers search-pattern backlink discovery, prospect discovery, and
# automated GEO citation checking (AnthropicSearchProvider). Without a
# key, everything else in the app still works -- those three features
# fail with a clean 502 upstream_error instead of a fake result.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Unset (default) = no auth enforced -- fine for local dev, NOT fine for
# a public deployment (this project has no real auth/projects layer; see
# docs/ARCHITECTURE.md §9). Set this to a random string before deploying
# publicly, and set the same value as the frontend's APP_SHARED_SECRET
# -- see docs/DEPLOYMENT.md.
APP_SHARED_SECRET=

CRAWLER_USER_AGENT=LinkIntelBot/0.1 (+https://example.invalid/bot)
CRAWLER_MAX_PAGES_PER_JOB=50
CRAWLER_RESPECT_ROBOTS_TXT=true

# Only set these if Playwright's own browser-revision resolution can't
# find a matching install in your environment (see app/core/config.py).
# In a normal `playwright install chromium` setup, leave both unset.
# PLAYWRIGHT_EXECUTABLE_PATH=
# PLAYWRIGHT_NO_SANDBOX=false
