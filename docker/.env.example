# Copy to docker/.env and adjust for local development.
# Never commit a real .env file — see ../.gitignore.

POSTGRES_USER=linkintel
POSTGRES_PASSWORD=linkintel
POSTGRES_DB=linkintel
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional AI providers (never required — Ollama is the default).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Backend
JWT_SECRET=change-me
BACKEND_CORS_ORIGINS=http://localhost:3000
