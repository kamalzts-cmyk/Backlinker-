# Server-side only -- never exposed to the browser (no NEXT_PUBLIC_
# prefix). Every backend call in this app runs in a Server Component or
# Server Action, so the browser never needs to know this URL.
API_URL=http://localhost:8000

# Unset (default) = no login gate, no header sent to the backend -- fine
# for local dev. For a public deployment, set this to the SAME value as
# the backend's APP_SHARED_SECRET -- see ../docs/DEPLOYMENT.md. It gates
# every page behind a single shared-password login (proxy.ts) and is
# sent as a header on every backend call (lib/api.ts) so the backend's
# own gate (backend/app/api/auth_gate.py) also lets it through.
APP_SHARED_SECRET=
